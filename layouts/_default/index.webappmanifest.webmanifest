{
  "name": "{{ .Site.Title }}",
  "short_name": "{{ .Site.Params.short_name | default .Site.Title }}",
  "start_url": "{{ .Site.BaseURL }}",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "/images/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/images/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
